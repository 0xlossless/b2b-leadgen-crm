# Supabase Postgres connection (use pooler URL for serverless)
DATABASE_URL=postgresql://postgres.[your-ref]:[your-password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Supabase public config (for client-side auth if needed)
NEXT_PUBLIC_SUPABASE_URL=https://[your-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[your-anon-key]

# OpenAI for AI features (email drafts, lead summaries)
OPENAI_API_KEY=sk-...
